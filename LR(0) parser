from collections import defaultdict, deque
grammar = defaultdict(list)
n = int(input("Enter number of productions: "))
print("Enter productions (Example: S->CC):")
for _ in range(n):
    lhs, rhs = input().replace(" ", "").split("->")
    for p in rhs.split("|"):
        grammar[lhs].append(p)
start = next(iter(grammar))
aug_start = start + "'"
while aug_start in grammar:
    aug_start += "'"
grammar[aug_start] = [start]
NT = set(grammar.keys())
EPS = '#'
def symbols(p):
    return list(p) if p != EPS else []
productions = []
for lhs in grammar:
    for rhs in grammar[lhs]:
        productions.append((lhs, rhs))
def closure(items):
    items = set(items)
    changed = True
    while changed:
        changed = False
        for lhs, rhs, dot in list(items):
            if dot < len(rhs):
                ch = rhs[dot]
                if ch in NT:
                    for p in grammar[ch]:
                        item = (ch, p, 0)
                        if item not in items:
                            items.add(item)
                            changed = True
    return frozenset(items)
def goto(items, symbol):
    new_items = set()
    for lhs, rhs, dot in items:
        if dot < len(rhs) and rhs[dot] == symbol:
            new_items.add((lhs, rhs, dot + 1))
    return closure(new_items) if new_items else frozenset()
C = [closure({(aug_start, start, 0)})]
transitions = {}
i = 0
while i < len(C):
    I = C[i]
    next_symbols = set()
    for lhs, rhs, dot in I:
        if dot < len(rhs):
            next_symbols.add(rhs[dot])
    for X in sorted(next_symbols):
        J = goto(I, X)
        if J not in C:
            C.append(J)
        transitions[(i, X)] = C.index(J)
    i += 1
print("\nCANONICAL COLLECTION OF LR(0) ITEMS")
for i, I in enumerate(C):
    print(f"\nI{i}:")
    for lhs, rhs, dot in sorted(I):
        r = rhs[:dot] + "." + rhs[dot:]
        print(f"  {lhs} -> {r}")
terminals = set()
for lhs, rhs in productions:
    for ch in symbols(rhs):
        if ch not in NT:
            terminals.add(ch)
terminals.add('$')
NT_without_start = NT - {aug_start}
ACTION = defaultdict(dict)
GOTO = defaultdict(dict)
conflict = False
def put_action(state, symbol, value):
    global conflict
    if symbol in ACTION[state] and ACTION[state][symbol] != value:
        conflict = True
        print("Conflict at state", state, symbol,
              ACTION[state][symbol], value)
    else:
        ACTION[state][symbol] = value
for i, I in enumerate(C):
    for lhs, rhs, dot in I:

        # Shift
        if dot < len(rhs):
            ch = rhs[dot]
            j = transitions[(i, ch)]
            if ch in terminals:
                put_action(i, ch, "s" + str(j))
            else:
                GOTO[i][ch] = j
        else:
            if lhs == aug_start:
                put_action(i, '$', 'acc')
            else:
                prod_no = productions.index((lhs, rhs)) + 1
                for t in terminals:
                    put_action(i, t, "r" + str(prod_no))
print("\nLR(0) PARSING TABLE")
columns = sorted(terminals - {'$'}) + ['$'] + sorted(NT_without_start)
print("State".ljust(8), end="")
for c in columns:
    print(c.center(10), end="")
print()
print("-" * (8 + 10 * len(columns)))
for i in range(len(C)):
    print(str(i).ljust(8), end="")
    for c in columns:
        if c in terminals:
            value = ACTION[i].get(c, "-")
        else:
            value = GOTO[i].get(c, "-")
        print(str(value).center(10), end="")
    print()
if conflict:
    print("\nGrammar is NOT LR(0).")
else:
    print("\nGrammar is LR(0).")
    inp = input("\nEnter input string: ") + '$'
    stack = [0]
    i = 0
    print("\nSTACK\t\tINPUT\t\tACTION")
    while True:
        state = stack[-1]
        current = inp[i]
        action = ACTION[state].get(current)
        print(stack, "\t\t", inp[i:], "\t\t", action)
        if action is None:
            print("\nString Rejected!")
            break
        if action == 'acc':
            print("\nString Accepted!")
            break
        elif action[0] == 's':
            stack.append(current)
            stack.append(int(action[1:]))
            i += 1
        elif action[0] == 'r':
            prod_no = int(action[1:])
            lhs, rhs = productions[prod_no - 1]
            length = 0 if rhs == EPS else len(rhs)
            if length:
                del stack[-2 * length:]
            state = stack[-1]
            stack.append(lhs)
            stack.append(GOTO[state][lhs])
            print("Reduce:", lhs, "->", rhs)
